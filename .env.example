# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=ithraa
DB_SYNCHRONIZE=false

# App
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
PORT=4000

# Paymob — use the regional base URL that matches your keys.
# Saudi Arabia (SAR): https://ksa.paymob.com  |  Egypt: https://accept.paymob.com
# UAE: https://uae.paymob.com  |  Oman: https://oman.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
PAYMOB_API_BASE=https://ksa.paymob.com
DEFAULT_PAYMENT_PROVIDER=paymob

# Capacity pricing (SAR per slot)
CAPACITY_UNIT_PRICE_SAR=99

# Payment session tuning
PAYMENT_EXPIRY_MINUTES=1440
PRIVATE_ATTEMPT_PAYMENT_EXPIRY_MINUTES=30
PAYMENT_MAX_RETRIES=3
